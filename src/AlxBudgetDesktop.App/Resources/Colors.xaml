<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Charte de base reprise d'alxBudget : vert = succès/recette/positif,
         rouge = erreur/suppression/remise/négatif, orange clair = projeté/TR,
         indigo clair = "à saisir". -->

    <Color x:Key="CouleurSucces">#1E7E34</Color>
    <Color x:Key="CouleurDanger">#C82333</Color>
    <Color x:Key="CouleurProjeteFond">#FFF3E0</Color>
    <Color x:Key="CouleurProjeteTexte">#E65100</Color>
    <Color x:Key="CouleurASaisirFond">#E8EAF6</Color>
    <Color x:Key="CouleurBordure">#DDDDDD</Color>
    <Color x:Key="CouleurLigneGrille">#EFEFEF</Color>
    <Color x:Key="CouleurAtténuee">#6C757D</Color>

    <SolidColorBrush x:Key="BrosseSucces" Color="{StaticResource CouleurSucces}" />
    <SolidColorBrush x:Key="BrosseDanger" Color="{StaticResource CouleurDanger}" />
    <SolidColorBrush x:Key="BrosseProjeteFond" Color="{StaticResource CouleurProjeteFond}" />
    <SolidColorBrush x:Key="BrosseProjeteTexte" Color="{StaticResource CouleurProjeteTexte}" />
    <SolidColorBrush x:Key="BrosseASaisirFond" Color="{StaticResource CouleurASaisirFond}" />
    <SolidColorBrush x:Key="BrosseBordure" Color="{StaticResource CouleurBordure}" />
    <SolidColorBrush x:Key="BrosseLigneGrille" Color="{StaticResource CouleurLigneGrille}" />
    <SolidColorBrush x:Key="BrosseAtténuee" Color="{StaticResource CouleurAtténuee}" />

</ResourceDictionary>
