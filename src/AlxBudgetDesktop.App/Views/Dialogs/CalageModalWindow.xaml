<Window x:Class="AlxBudgetDesktop.App.Views.Dialogs.CalageModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corriger le solde d'ouverture" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">

        <TextBlock Text="Corriger le solde d'ouverture" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="Saisissez le solde réel de chaque compte (lu dans votre appli bancaire ou sur la carte)."
                   TextWrapping="Wrap" Foreground="{StaticResource BrosseAtténuee}" Margin="0,0,0,16" />

        <!-- Compte courant -->
        <TextBlock Text="Compte courant" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,4">
            <TextBlock Text="Report du mois précédent" HorizontalAlignment="Left" Foreground="{StaticResource BrosseAtténuee}" />
            <TextBlock Text="{Binding ReportCourant, StringFormat={}{0:0.00} €}" HorizontalAlignment="Right" Foreground="{StaticResource BrosseAtténuee}" />
        </Grid>
        <TextBox Text="{Binding CourantTexte, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,16">
            <TextBlock Text="Correction" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding CorrectionCourant, StringFormat={}{0:+0.00;-0.00;0.00} €}" HorizontalAlignment="Right">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrosseDanger}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CorrectionCourantPositive}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrosseSucces}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Carte TR -->
        <TextBlock Text="Carte tickets restaurant" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,4">
            <TextBlock Text="Report du mois précédent" HorizontalAlignment="Left" Foreground="{StaticResource BrosseAtténuee}" />
            <TextBlock Text="{Binding ReportTr, StringFormat={}{0:0.00} €}" HorizontalAlignment="Right" Foreground="{StaticResource BrosseAtténuee}" />
        </Grid>
        <TextBox Text="{Binding TrTexte, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,16">
            <TextBlock Text="Correction" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding CorrectionTr, StringFormat={}{0:+0.00;-0.00;0.00} €}" HorizontalAlignment="Right">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrosseDanger}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CorrectionTrPositive}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrosseSucces}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Épargne -->
        <TextBlock Text="Épargne" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,4">
            <TextBlock Text="Report du mois précédent" HorizontalAlignment="Left" Foreground="{StaticResource BrosseAtténuee}" />
            <TextBlock Text="{Binding ReportEpargne, StringFormat={}{0:0.00} €}" HorizontalAlignment="Right" Foreground="{StaticResource BrosseAtténuee}" />
        </Grid>
        <TextBox Text="{Binding EpargneTexte, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,16">
            <TextBlock Text="Correction" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding CorrectionEpargne, StringFormat={}{0:+0.00;-0.00;0.00} €}" HorizontalAlignment="Right">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrosseDanger}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CorrectionEpargnePositive}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrosseSucces}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <DockPanel>
            <Button Content="Revenir au report auto" Command="{Binding RevenirReportAutoCommand}" Padding="10,6"
                    DockPanel.Dock="Left"
                    Visibility="{Binding EstDejaCale, Converter={StaticResource ConvertisseurBoolVersVisibilite}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Command="{Binding AnnulerCommand}" Padding="12,6" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Enregistrer" Command="{Binding EnregistrerCommand}" Padding="12,6" IsDefault="True" />
            </StackPanel>
        </DockPanel>

    </StackPanel>
</Window>
