<Window x:Class="Fluxo.App.Views.Dialogs.ConfirmActionModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titre}" Height="200" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Titre}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Top" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" Padding="12,6" Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="{Binding TexteBoutonConfirmer}" Command="{Binding ConfirmerCommand}"
                    Padding="12,6" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
