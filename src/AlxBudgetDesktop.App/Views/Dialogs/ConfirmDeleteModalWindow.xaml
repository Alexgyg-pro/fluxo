<Window x:Class="AlxBudgetDesktop.App.Views.Dialogs.ConfirmDeleteModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titre}" Height="180" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Titre}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" VerticalAlignment="Top">
            <Run Text="{Binding Etiquette, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text=" — " />
            <Run Text="{Binding Montant, StringFormat={}{0:0.00} €, Mode=OneWay}" />
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" Padding="12,6" Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="Supprimer" Command="{Binding ConfirmerCommand}"
                    Style="{StaticResource StyleBoutonDanger}" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
