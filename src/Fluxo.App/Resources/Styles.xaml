<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Barre d'onglets custom (pas de TabControl natif) : un ItemsControl horizontal
         (pas un ListBox/Selector) — la sélection est pilotée explicitement par
         MainWindowViewModel.EstSelectionne sur chaque onglet, pas par le mécanisme de
         sélection intégré de WPF. Cf. TabViewModelBase.EstSelectionne : un Selector lié
         en TwoWay à une valeur absente de sa propre liste ne se désélectionne pas tout
         seul, ce qui provoquait une double sélection visuelle et des clics sans effet
         (BACKLOG US-001). Boutons + ItemsControl évitent complètement ce mécanisme. -->
    <Style x:Key="StyleBarreOnglets" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Style générique (Budget/Import/Admin) : inchangé, pas de traitement "onglet". -->
    <Style x:Key="StyleOngletBouton" TargetType="Button">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding EstSelectionne}" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource BrosseASaisirFond}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="#F5F5F5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style des onglets mois : chaque onglet porte sa propre ligne basse (leur
         alignement côte à côte donne l'impression d'une seule ligne continue sous
         tout l'ensemble). L'onglet sélectionné n'a PAS de ligne basse mais un
         contour gauche/haut/droit, pour ressembler à un vrai onglet qui se détache
         de la ligne — chaque Bouton est indépendant, pas de superposition à gérer. -->
    <Style x:Key="StyleOngletMoisBouton" TargetType="Button" BasedOn="{StaticResource StyleOngletBouton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{StaticResource BrosseBordure}"
                            BorderThickness="0,0,0,1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding EstSelectionne}" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource BrosseASaisirFond}" />
                            <Setter TargetName="Fond" Property="BorderThickness" Value="1,1,1,0" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="#F5F5F5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton d'aide (icône "?") : rond, discret, pas un onglet — pas de
         traitement EstSelectionne, juste un survol. -->
    <Style x:Key="StyleBoutonAide" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrosseAtténuee}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" CornerRadius="14" BorderBrush="{StaticResource BrosseBordure}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="#F5F5F5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton "thème" de la colonne de gauche de la fenêtre d'aide : liste
         verticale, pleine largeur, surbrillance sur le thème sélectionné. -->
    <Style x:Key="StyleSujetAideBouton" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding EstSelectionne}" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource BrosseASaisirFond}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="#F5F5F5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyleBoutonDanger" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource BrosseDanger}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

</ResourceDictionary>
