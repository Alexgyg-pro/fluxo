<Window x:Class="AlxBudgetDesktop.App.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="alxBudgetDesktop" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Bandeau titre : nom de l'application à gauche, année gérée à droite. -->
        <Grid Grid.Row="0" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="alxBudgetDesktop" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Annee, StringFormat='Année {0}'}" FontSize="16"
                       VerticalAlignment="Center" Foreground="{StaticResource BrosseAtténuee}" />
        </Grid>

        <!-- Barre d'onglets custom : pas de TabControl natif, pour rester fidèle au
             shell "onglets maison" côté React (App.tsx). Deux groupes distincts
             partageant la même sélection : les mois à gauche, Budget/Import/Admin
             à droite (DockPanel pousse chaque groupe vers son bord). -->
        <Border Grid.Row="1" Margin="24,0,24,0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrosseBordure}">
        <DockPanel LastChildFill="False">
            <ListBox DockPanel.Dock="Left"
                     Style="{StaticResource StyleBarreOnglets}"
                     ItemContainerStyle="{StaticResource StyleOngletItem}"
                     ItemsSource="{Binding OngletsMois}"
                     SelectedItem="{Binding OngletSelectionne, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Titre}" />
                            <TextBlock Text=" ✓" Foreground="{StaticResource BrosseSucces}" FontWeight="Bold"
                                       Visibility="{Binding EstValide, Converter={StaticResource ConvertisseurBoolVersVisibilite}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox DockPanel.Dock="Right"
                     Style="{StaticResource StyleBarreOnglets}"
                     ItemContainerStyle="{StaticResource StyleOngletItem}"
                     ItemsSource="{Binding OngletsAutres}"
                     SelectedItem="{Binding OngletSelectionne, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Titre}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding OngletSelectionne}" Margin="24,16,24,24" />
    </Grid>
</Window>
